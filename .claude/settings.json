{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run build)",
      "Bash(./gradlew test)",
      "Bash(./gradlew build)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./frontend/.env*)",
      "Read(./backend/.env)",
      "Read(./backend/.env.*)",
      "Read(./.vercel/**)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(vercel --prod *)",
      "Bash(vercel deploy *)",
      "Bash(vercel env pull *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[개발 교훈 위키 목차] 작업과 관련된 제목이 있으면 시작 전에 docs/wiki/의 그 파일에서 해당 항목을 읽는다.\"; awk '/^## 목차/{p=1} p' \"$CLAUDE_PROJECT_DIR/docs/wiki/README.md\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-merged-migration.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/warn-forbidden-phrases.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
