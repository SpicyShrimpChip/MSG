# deploy/backend.env (커밋하지 않는다, chmod 600). 백엔드 컨테이너만 읽는다: cp backend.env.example backend.env
# 각 값의 뜻은 docs/deploy.md "백엔드 환경변수" 표. DB 접속 정보는 compose.yaml이 .env에서 넣어 준다

# Base64 32바이트 이상: openssl rand -base64 48
JWT_SECRET=
# 사용자가 쓰는 주소(Vercel). 같은 출처로 요청하지만 브라우저가 Origin을 붙이므로 넣는다
CORS_ALLOWED_ORIGINS=https://lms-seven-tawny.vercel.app

# AI 모델 (키나 모델 이름이 비면 그 모델은 "미설정")
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# 서비스 전체 하루 모델 호출 상한. 제공사 콘솔 지출 한도와 함께 정한다
AI_DAILY_CALL_LIMIT=500

# Cloudflare Turnstile 비밀 키 (Vercel의 VITE_TURNSTILE_SITE_KEY와 같이 켠다)
TURNSTILE_SECRET_KEY=
# 탈퇴 뒤 30일 재가입 제한용 키, 32자 이상 무작위. 운영 중에는 바꾸지 않는다(다른 서버로 옮길 때도 그대로)
REJOIN_HASH_SECRET=

# 카카오 로그인 (카카오 개발자 콘솔의 앱 키). 셋 중 하나라도 비면 로그인 화면에 카카오 버튼이 나오지 않는다
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 탈퇴할 때 카카오 연결 끊기에 쓴다. 비면 연결 끊기를 건너뛴다
KAKAO_ADMIN_KEY=
# 카카오 콘솔에 등록한 Redirect URI와 글자까지 같아야 한다
KAKAO_REDIRECT_URI=https://lms-seven-tawny.vercel.app/api/auth/kakao/callback
# 카카오 로그인이 끝나면 돌아갈 화면 주소
FRONTEND_BASE_URL=https://lms-seven-tawny.vercel.app

# 학습 자료 본문을 외부 AI로 보내는 기능. 처리방침에 확정한 뒤에만 true
MATERIAL_CONTENT_ENABLED=false
