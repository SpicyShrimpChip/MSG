# 백엔드 앞단. BACKEND_HOST(예: 3-25-10-20.sslip.io)로 HTTPS 인증서를 자동으로 받고 /api만 백엔드로 넘긴다.
# 요청은 브라우저 → Vercel(/api rewrite) → 여기 → 백엔드 순서로 온다.
{
	servers {
		# Vercel이 붙여 보낸 X-Forwarded-For의 첫 값(브라우저의 IP)을 접속 IP로 본다. docs/deploy.md "실제 접속 IP"
		trusted_proxies static 0.0.0.0/0 ::/0
		client_ip_headers X-Forwarded-For
	}
}

{$BACKEND_HOST} {
	# 자료 업로드(백엔드 한도 21MB)보다 조금 크게
	request_body {
		max_size 25MB
	}

	handle /api/* {
		reverse_proxy backend:8080 {
			# 백엔드(server.forward-headers-strategy: native)가 이 값 하나를 접속 IP로 쓴다
			header_up X-Forwarded-For {client_ip}
		}
	}

	# API 문서(/swagger-ui 등)를 포함해 /api 밖은 열지 않는다
	handle {
		respond 404
	}
}
