# deploy/.env (커밋하지 않는다, chmod 600). 이 파일을 복사해 값을 채운다: cp env.example .env
# 비밀번호는 서버에서 만든다: openssl rand -base64 32 | tr -d '/+=' | head -c 32

# 백엔드 주소. 탄력적 IP가 3.25.10.20이면 3-25-10-20.sslip.io (Vercel rewrite 주소와 같게)
BACKEND_HOST=

# PostgreSQL 관리자(postgres) 비밀번호. 백업·복원 때만 쓴다
POSTGRES_PASSWORD=
# 백엔드 계정(msg_app)·마이그레이션 계정(msg_migrator) 비밀번호.
# 처음 띄울 때 DB에 그대로 만들어지므로, 나중에 바꾸려면 DB의 비밀번호도 같이 바꿔야 한다
APP_DB_PASSWORD=
MIGRATION_DB_PASSWORD=

# 보통은 비워 둔다. 로컬에서 직접 만든 이미지로 시험할 때만: BACKEND_IMAGE=msg-backend:local
# BACKEND_IMAGE=
# 로컬 PC에서 80·443이 이미 쓰이고 있을 때만
# HTTP_PORT=8081
# HTTPS_PORT=8443
